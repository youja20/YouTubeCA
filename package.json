{
  "name": "youtubeca",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "dev": "concurrently --kill-others-on-fail -n api,daemon,web -c cyan,magenta,green \"pnpm --filter @youtubeca/api dev\" \"pnpm --filter @youtubeca/daemon dev\" \"pnpm --filter @youtubeca/web dev\"",
    "db:migrate": "pnpm --filter @youtubeca/db migrate",
    "db:generate": "pnpm --filter @youtubeca/db generate",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "crawl": "pnpm --filter @youtubeca/daemon crawl"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
