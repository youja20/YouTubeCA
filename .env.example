# ─── YouTube Data API v3 ──────────────────────────────────
# Google Cloud Console에서 발급 (YouTube Data API v3 전용으로 API 제한 권장)
YOUTUBE_API_KEY=

# ─── LLM (Google Gemini) ──────────────────────────────────
# Google AI Studio(https://aistudio.google.com/apikey)에서 발급
GEMINI_API_KEY=
# 비우면 gemini-3.7-flash를 쓴다. flash 계열 최신 모델을 권장.
# 항상 최신을 따라가려면 gemini-flash-latest 별칭도 쓸 수 있다.
LLM_MODEL=gemini-3.7-flash

# ─── 선택 ────────────────────────────────────────────────
# PORT=3200
# DATABASE_URL=./data/youtubeca.db
# LOG_LEVEL=info
# LLM 응답 대기 상한(ms). 기본 120000.
# LLM_TIMEOUT_MS=120000
# Gemini OpenAI 호환 엔드포인트 재정의 (기본값이면 건드릴 필요 없음)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
